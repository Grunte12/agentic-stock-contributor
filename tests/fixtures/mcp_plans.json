[
  {
    "case": "supply_one_phrase",
    "calls": [
      {
        "tool": "stock_status",
        "arguments": {}
      },
      {
        "tool": "stock_scan",
        "arguments": {
          "requests": [
            {
              "keyword": "matcha latte",
              "media_type": "photo",
              "ai_filter": "all",
              "order": "relevance"
            },
            {
              "keyword": "matcha latte",
              "media_type": "photo",
              "ai_filter": "only_ai",
              "order": "relevance"
            },
            {
              "keyword": "matcha latte",
              "media_type": "photo",
              "ai_filter": "all",
              "order": "downloads"
            }
          ]
        }
      },
      {
        "tool": "stock_wait",
        "arguments": {
          "job_ids": [
            "job-a",
            "job-b",
            "job-c"
          ],
          "timeout_seconds": 1
        }
      },
      {
        "tool": "stock_report",
        "arguments": {
          "keywords": [
            "matcha latte"
          ]
        }
      }
    ],
    "action": "read the verified report"
  },
  {
    "case": "captcha_stop",
    "calls": [
      {
        "tool": "stock_status",
        "arguments": {}
      }
    ],
    "action": "captcha: do not resume"
  },
  {
    "case": "disconnected",
    "calls": [
      {
        "tool": "stock_status",
        "arguments": {}
      }
    ],
    "action": "unmeasured until extension reconnects"
  },
  {
    "case": "daily_cap",
    "calls": [
      {
        "tool": "stock_status",
        "arguments": {}
      }
    ],
    "action": "daily_cap: do not scan again"
  },
  {
    "case": "outcomes",
